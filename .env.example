# Payment Mode: "manual_upi" (active) or "razorpay" (dormant fallback)
PAYMENT_MODE=manual_upi

# Neon PostgreSQL Connection URL
# Copy from your Neon Console (Project: VCC, Branch: production)
# Connection pooling endpoint or direct endpoint with sslmode=require
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://vcc_user:your_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/vcc?sslmode=require

# Manual UPI Payment Configuration
UPI_ID=kavinakshara6240@okicici
UPI_PAYEE_NAME=Kavin Ragav
UPI_QR_IMAGE_PATH=/lovable-uploads/upi-payment-qr.jpg
SUPPORT_WHATSAPP=8940399717

# Razorpay Credentials (dormant - kept for future reactivation)
# When ready to restore Razorpay, set PAYMENT_MODE=razorpay and fill valid credentials:
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Google OAuth Credentials (obtain from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript Origins: https://your-domain.com and http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Admin Authentication & Dashboard Security
# If set, administrator can log in directly using this email and password, or by signing in with Google using this email.
ADMIN_EMAIL=kavinakshara6240@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_cryptographic_secret_here

# Frontend API Base URL (defaults to https://vcc2.onrender.com in production build and empty string in local dev)
VITE_API_BASE_URL=https://vcc2.onrender.com

# App Port (defaults to 3000)
PORT=3000